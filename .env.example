# Copy this file to .env and add your local secrets.
# Keep real credentials out of version control.

# Competitor intelligence report
REPORT_EMAIL_TO=aditijain1100@gmail.com
REPORT_TIMEZONE=Asia/Kolkata
REPORT_SEND_HOUR=9

# MongoDB (sent-email archive). Use a MongoDB Atlas connection string; never commit the real one.
MONGODB_URI=
MONGODB_DB=clarix
MONGODB_COLLECTION=emails

# Example values:
# API_KEY=
# BASE_URL=
# GOOGLE_CREDENTIALS_PATH=
